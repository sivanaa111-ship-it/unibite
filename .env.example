# ------------------------------------------------------------------
# UniBite configuration. Copy to .env (or set in your host's dashboard).
# Never commit real values.
# ------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Public URL used in emailed links (verification, invitations, resets)
APP_URL=https://unibite.your-university.edu
# REQUIRED in production: long random string that signs session tokens
JWT_SECRET=change-me-to-a-long-random-string

# --- Email delivery (REQUIRED in production) ---
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UniBite <no-reply@your-university.edu>"

# --- Student verification ---
# Comma-separated university email domains (subdomains allowed)
UNIVERSITY_EMAIL_DOMAINS=your-university.edu
# Regular expression a University ID must match
UNIVERSITY_ID_PATTERN=^[0-9]{7,10}$
# auto (default) = check the imported roster when one exists, else format only
# roster = ID must exist in the roster (npm run roster:import -- roster.csv)
# format = pattern only; admins can mark IDs verified manually
UNIVERSITY_ID_VERIFICATION=auto

# --- First Super Admin (optional alternative to `npm run admin:create`) ---
# Used ONLY when no admin exists yet. Remove ADMIN_PASSWORD after first boot.
# ADMIN_EMAIL=owner@your-university.edu
# ADMIN_PASSWORD=a-long-unique-password
# ADMIN_NAME=Platform Owner

# Optional storage locations
# DATA_DIR=./data
# UPLOAD_DIR=./uploads
